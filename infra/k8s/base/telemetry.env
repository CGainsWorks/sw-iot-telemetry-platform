# Non-secret configuration for every service.
#
# Rendered into a ConfigMap by kustomize with a content hash in its name, so a
# change here rolls the pods that consume it. A hand-written ConfigMap would be
# updated in place and the running pods would keep the old values until someone
# restarted them by hand.

# --- Observability ---
OBS_LOG_LEVEL=INFO
OBS_LOG_JSON=true
OBS_METRICS_PORT=9100

# --- Database ---
PG_HOST=timescaledb.telemetry.svc.cluster.local
PG_PORT=5432
PG_DATABASE=telemetry
PG_USER=telemetry
# Pool sizing is per replica. Three processing replicas at 10 connections plus
# two API replicas at 10 is 50, comfortably inside max_connections=200 with room
# for the migration job and a human with psql.
PG_MIN_POOL=2
PG_MAX_POOL=10

# --- Stream ---
# Unused on AWS: there, an IoT Core topic rule writes to Kinesis and the
# processing service reads Kinesis. Point this at an MSK bootstrap endpoint to
# run Kafka in-cluster instead.
KAFKA_BOOTSTRAP_SERVERS=redpanda.telemetry.svc.cluster.local:9092
KAFKA_TELEMETRY_TOPIC=telemetry.normalised
KAFKA_STATUS_TOPIC=device.status
KAFKA_DLQ_TOPIC=telemetry.deadletter
KAFKA_ALERTS_TOPIC=alerts.fired
KAFKA_CONSUMER_GROUP=telemetry-platform

# --- MQTT ---
# Replace MQTT_HOST with the iot_endpoint Terraform output when using IoT Core.
MQTT_HOST=mosquitto.telemetry.svc.cluster.local
MQTT_PORT=8883
MQTT_TLS=true
MQTT_CA_CERT=/certs/ca/ca.crt
MQTT_CLIENT_CERT=/certs/services/ingest-bridge.crt
MQTT_CLIENT_KEY=/certs/services/ingest-bridge.key
MQTT_TENANT=acme
MQTT_VERIFY_HOSTNAME=true

# --- API ---
API_CORS_ORIGINS=https://telemetry.example.com
