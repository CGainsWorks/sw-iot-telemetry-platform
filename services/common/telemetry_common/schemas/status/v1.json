{
  "$defs": {
    "LifecycleEvent": {
      "description": "Connection lifecycle, published on the status topic.",
      "enum": [
        "boot",
        "online",
        "offline",
        "ota_started",
        "ota_completed",
        "ota_failed"
      ],
      "title": "LifecycleEvent",
      "type": "string"
    }
  },
  "$id": "https://schemas.cgainsworks.dev/iot-telemetry/status/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A lifecycle transition. Also used as the MQTT last will and testament.",
  "properties": {
    "device_id": {
      "description": "Lower-case device identity, matches the TLS certificate common name",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$",
      "title": "Device Id",
      "type": "string"
    },
    "event": {
      "$ref": "#/$defs/LifecycleEvent"
    },
    "fw_version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Fw Version",
      "type": "string"
    },
    "reason": {
      "anyOf": [
        {
          "maxLength": 256,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason"
    },
    "schema_version": {
      "default": "1.1.0",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "site_id": {
      "description": "Physical site the device is installed at",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$",
      "title": "Site Id",
      "type": "string"
    },
    "ts": {
      "format": "date-time",
      "title": "Ts",
      "type": "string"
    }
  },
  "required": [
    "device_id",
    "site_id",
    "ts",
    "event",
    "fw_version"
  ],
  "title": "status",
  "type": "object",
  "x-schema-version": "1.1.0"
}
