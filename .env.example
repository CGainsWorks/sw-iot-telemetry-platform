# Copy to .env to override any of the Compose defaults. .env is gitignored.
#
# Everything here has a working default in docker-compose.yml, so `docker compose
# up` needs no .env at all. This file exists to document what is adjustable.

# --- Fleet -----------------------------------------------------------------
# Devices to provision certificates for and simulate. The PKI job issues one
# certificate per device, so raising this makes the first start slower.
DEVICE_COUNT=10
DEVICE_PREFIX=esp32
TENANT=acme

# Share of the fleet that exhibits an injected fault. Faults are what make the
# dead-letter path and the alerting rules demonstrable; set 0 for a quiet fleet.
FAULT_FRACTION=0.2

# Seed. Fixes which devices are faulty and what they report, so a run is
# reproducible.
SIM_SEED=1

# Spread of prior device uptime in hours. Without it every device boots with a
# full battery and the same diurnal phase, which no real fleet does.
WARM_START_HOURS=72

# --- Ports -----------------------------------------------------------------
MQTT_PORT=8883
KAFKA_PORT=19092
PG_PORT=5432
API_PORT=8000
WEB_PORT=5173
INGEST_METRICS_PORT=9101
PROCESSING_METRICS_PORT=9102
ALERTING_METRICS_PORT=9103

# --- Database --------------------------------------------------------------
PG_DATABASE=telemetry
PG_USER=telemetry
# Fine for a local stack on a loopback port. Change it for anything else.
PG_PASSWORD=telemetry

# --- Stream ----------------------------------------------------------------
# Partitions on the telemetry topic. This is the ceiling on processing replicas:
# a consumer group cannot use more consumers than there are partitions.
TELEMETRY_PARTITIONS=6

# --- Alerting --------------------------------------------------------------
# Leave empty and the webhook channel records its deliveries as "suppressed"
# rather than pretending to have sent them.
ALERT_WEBHOOK_URL=

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO
