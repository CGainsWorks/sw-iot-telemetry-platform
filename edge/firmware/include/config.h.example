// Per-device configuration. Copy to config.h and fill in.
//
// config.h is gitignored. The certificate and private key below are the device's
// identity: a committed key is a disclosed key, and every device sharing one
// defeats the entire point of certificate-bound identity.
//
// For more than a handful of devices, do not use this file at all. Provision at
// manufacture through NVS, or use AWS IoT fleet provisioning so each board
// claims its own certificate on first boot. See docs/provisioning.md.

#pragma once

// --- Identity --------------------------------------------------------------
// DEVICE_ID must equal the common name of the certificate below. The broker
// takes the identity from the certificate, and the platform rejects any message
// whose payload disagrees with the topic, so a mismatch here means every message
// this device sends is dead-lettered.
#define DEVICE_ID   "esp32-000001"
#define SITE_ID     "site-a"
#define TENANT      "acme"
#define FW_VERSION  "1.4.2"

// --- Network ---------------------------------------------------------------
#define WIFI_SSID       "your-ssid"
#define WIFI_PASSWORD   "your-password"

#define MQTT_HOST   "your-broker.example.com"
#define MQTT_PORT   8883

// --- Behaviour -------------------------------------------------------------
// Seconds between samples. The platform's device-offline rule allows ten
// minutes of silence, so anything above about 300 needs that rule widening.
#define SAMPLE_INTERVAL_S   10

// On-board LED, blinked by the identify command so an engineer can pick this
// node out of a wall of identical boxes. GPIO2 on most ESP32 dev boards, GPIO8
// on many C3 boards. Set to -1 if the board has none.
//
// Not LED_BUILTIN: that macro is only defined for boards whose variant file
// declares it, and the generic esp32dev target does not, so using it fails to
// compile on exactly the board most people have.
#define STATUS_LED_PIN  2

// Deep sleep between samples. Cuts average draw from roughly 80 mA to under
// 1 mA, at the cost of a full Wi-Fi and TLS handshake on every wake, which is
// itself about 2 seconds at 120 mA. Below roughly a 30 second interval the
// handshake costs more than staying awake.
#define USE_DEEP_SLEEP      0

// --- Certificates ----------------------------------------------------------
// The CA that signed the broker's certificate. Used to verify the broker, so
// that the device cannot be tricked into publishing to an impostor.
static const char CA_CERT[] PROGMEM = R"EOF(
-----BEGIN CERTIFICATE-----
...paste certs/ca/ca.crt here...
-----END CERTIFICATE-----
)EOF";

// This device's own certificate, from scripts/pki.sh device <id>.
static const char DEVICE_CERT[] PROGMEM = R"EOF(
-----BEGIN CERTIFICATE-----
...paste certs/devices/<id>/<id>.crt here...
-----END CERTIFICATE-----
)EOF";

// This device's private key. Never leaves the device, never enters a repository.
static const char DEVICE_KEY[] PROGMEM = R"EOF(
-----BEGIN PRIVATE KEY-----
...paste certs/devices/<id>/<id>.key here...
-----END PRIVATE KEY-----
)EOF";
